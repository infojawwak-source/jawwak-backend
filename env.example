# ══════════════════════════════════════════════
# انسخ الملف ده وسمّيه .env (بدون .example)
# وحط فيه المفتاح اللي هتاخده من حساب Duffel بتاعك
# ══════════════════════════════════════════════

# من https://app.duffel.com → Developers → Access Tokens
# مفتاح التجربة بيبدأ بـ duffel_test_
# ومفتاح الإنتاج الحقيقي بيبدأ بـ duffel_live_
DUFFEL_ACCESS_TOKEN=حط_المفتاح_هنا

PORT=3000
